+
+  subroutine extend_real_array(rarr, new_size)
+
+    ! extend a real array if necessary and pad new entries with zeros
+
+    implicit none
+
+    _REAL_, pointer :: rarr(:)
+    integer, intent(in) :: new_size
+
+    integer :: ier, old_size
+    _REAL_, allocatable :: tmp(:)
+
+    old_size = size (rarr)
+
+    if (old_size < new_size) then
+
+       allocate ( tmp(old_size), stat=ier )
+       REQUIRE(ier == 0)
+
+       tmp(:) = rarr(:)
+
+       deallocate ( rarr, stat=ier )
+       REQUIRE(ier == 0)
+
+       allocate ( rarr(new_size), stat=ier )
+       REQUIRE(ier == 0)
+
+       rarr(1:old_size) = tmp(1:old_size)
+       rarr(old_size+1:new_size) = 0.0d0
+
+       deallocate ( tmp, stat=ier )
+       REQUIRE(ier == 0)
+
+    end if
+
+  end subroutine extend_real_array
+
